#!/bin/sh
# launch-gui-agent: print the Exec command of the installed GUI IDE, or exit 1.
#
# The openbox desktop is built before the agent layers, so it cannot know at
# build time which agent is installed. This runtime helper scans the installed
# .desktop launchers and prints the command of a GUI IDE (Antigravity IDE = ag,
# OpenCode Desktop = od). Callers exec the output (agent-starter, autostart)
# or fall back to the terminal agent flow when nothing is printed.
#
# Matching is on the base name of the program the entry execs - not the file
# name, and not the directory the program sits in. The vendor keeps the
# program name; the path is its own business. Antigravity 1.23.2 execs
# /usr/share/antigravity/antigravity and leaves /usr/bin/antigravity a symlink
# that no Exec line names. The programs the agent layers install are:
#   - ai.opencode.desktop  (OpenCode Desktop)
#   - antigravity          (Antigravity IDE)
# CLI launchers (Exec=agy, Exec=agent-starter) carry neither name.
for f in /usr/share/applications/*.desktop; do
    [ -f "$f" ] || continue
    # NoDisplay entries are handlers, not the way in. Antigravity ships one
    # that execs the same program with --open-url, and it sorts ahead of the
    # real entry in this glob.
    grep -q '^NoDisplay=true' "$f" && continue
    cmd=$(sed -n 's/^Exec=//p' "$f" | head -n 1)
    [ -n "$cmd" ] || continue
    prog=${cmd%% *}
    case "${prog##*/}" in
        ai.opencode.desktop|antigravity) ;;
        *) continue ;;
    esac
    # Strip desktop-entry field codes (%U, %F, %i, %c, %k) so the command runs
    # cleanly when invoked directly (no %-args passed literally), and trim the
    # trailing whitespace left behind by a stripped %U at line end.
    cmd=$(printf '%s' "$cmd" | sed 's/%[A-Za-z]//g' | sed 's/[[:space:]]*$//')
    if [ -n "$cmd" ]; then
        printf '%s\n' "$cmd"
        exit 0
    fi
done
exit 1
