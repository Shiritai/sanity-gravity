#!/usr/bin/env bash
# agent-starter: the entry point to the coding agents on the openbox desktop.
#
# Openbox is a window manager with no panel and no desktop icons, so this
# script (and the session autostart) is how a user reaches the installed
# agent. Which agent that is can only be decided at runtime: the openbox
# layer is built before the agent layer, so this script cannot know the
# image contents.
set -u

# A GUI agent is the main window when one is installed; the terminal flow
# below is for CLI-only combinations. The call goes through the .desktop
# launcher so the vendor's own flags (--no-sandbox and friends) are set
# exactly as they would be on a menu click.
GUI_CMD=$(/usr/local/bin/launch-gui-agent 2>/dev/null)
if [ -n "$GUI_CMD" ]; then
    echo "--> Starting the GUI agent..."
    eval "exec $GUI_CMD"
fi

# The workspace is bind-mounted at $HOME/workspace (see
# compose/generators.py). WORKSPACE_DIR overrides it.
WORKSPACE_DIR="${WORKSPACE_DIR:-$HOME/workspace}"

# Terminal agents in priority order; the first command found is started
# (cc->claude, cx->codex, gc->gemini, oc->opencode, agy->agy). The known
# install paths are probed after command -v so detection still works under
# a restricted PATH (one without /usr/local/bin, say).
AGENT_BIN=""
for cand in claude codex gemini opencode agy; do
    if p=$(command -v "$cand" 2>/dev/null) && [ -n "$p" ]; then
        AGENT_BIN="$p"
        break
    fi
done
if [ -z "$AGENT_BIN" ]; then
    for p in \
        /usr/local/bin/opencode /usr/bin/opencode \
        /usr/local/bin/claude /usr/bin/claude \
        /usr/local/bin/codex /usr/bin/codex \
        /usr/local/bin/gemini /usr/bin/gemini \
        /usr/local/bin/agy /usr/bin/agy; do
        if [ -x "$p" ]; then
            AGENT_BIN="$p"
            break
        fi
    done
fi

# Start the agent (or a shell) in the current directory. exec replaces the
# running shell, so this script does not return past here.
start_agent() {
    if [ -n "$AGENT_BIN" ]; then
        echo "--> Starting the coding agent ($AGENT_BIN)..."
        exec "$AGENT_BIN"
    else
        echo "--> No terminal agent installed. Opening a shell..."
        echo "    (diagnostic: PATH=$PATH)" >&2
        exec "${SHELL:-/bin/bash}"
    fi
}

# Ask for a name, create the directory and start the agent inside it.
# 'q' or EOF (Ctrl-D) cancels.
create_and_start() {
    local name=""
    while true; do
        printf "Name for the new project (or 'q' to cancel): "
        read -r name || { echo; exit 0; }
        name="$(printf '%s' "$name" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')"
        if [ "$name" = "q" ]; then
            exit 0
        fi
        if [ -z "$name" ]; then
            echo "Please enter a project name."
            continue
        fi
        if [ -e "$WORKSPACE_DIR/$name" ]; then
            echo "The entry '$name' already exists."
            continue
        fi
        break
    done

    mkdir -p "$WORKSPACE_DIR/$name" || exit 1
    cd "$WORKSPACE_DIR/$name" || exit 1
    echo "--> New project created: $(pwd)"
    start_agent
}

cd "$WORKSPACE_DIR" 2>/dev/null || {
    echo "Workspace directory $WORKSPACE_DIR not found."
    echo "Create it or clone a repository into it, then start again."
    exec "${SHELL:-/bin/bash}"
}

# NUL-delimited: a project directory may contain spaces or newlines, and
# an unquoted $(find ...) would split one such name into several entries.
projects=()
while IFS= read -r -d '' dir; do
    projects+=("${dir#./}")
done < <(find . -mindepth 1 -maxdepth 1 -type d -print0 | sort -z)

if [ ${#projects[@]} -eq 0 ]; then
    echo "No project directory found in $WORKSPACE_DIR."
    create_and_start
fi

echo "=== Coding Agent Starter ==="
echo "Choose a project directory:"

select proj in "${projects[@]}" "Create a new project"; do
    if [ "$proj" == "Create a new project" ]; then
        create_and_start
        break
    elif [ -n "$proj" ]; then
        cd "$WORKSPACE_DIR/$proj" || exit 1
        echo "--> Changed to: $(pwd)"
        start_agent
    else
        echo "Invalid choice."
    fi
done

# Only reachable when select ended on EOF (Ctrl-D).
echo "Selection cancelled."
exit 0
