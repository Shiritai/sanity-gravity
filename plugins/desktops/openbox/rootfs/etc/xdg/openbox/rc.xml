<?xml version="1.0" encoding="UTF-8"?>

<!--
  Openbox configuration for the sanity-gravity openbox desktop.

  The Debian default rc.xml wires the root menu to /var/lib/openbox/
  debian-menu.xml (generated by the 'menu' package), which is not installed
  here. This config instead loads our own root menu from menu.xml, so the
  right-click menu and the Super/Alt+Space keybinding reach the
  agent-starter and terminal entries.
-->
<openbox_config xmlns="http://openbox.org/3.6/config">

  <resistance>
    <strength>10</strength>
  </resistance>

  <focus>
    <focusNew>yes</focusNew>
    <followMouse>no</followMouse>
    <raiseOnFocus>no</raiseOnFocus>
    <focusLast>yes</focusLast>
    <underMouse>no</underMouse>
    <focusDelay>200</focusDelay>
    <raiseDelay>500</raiseDelay>
  </focus>

  <placement>
    <policy>Smart</policy>
    <center>yes</center>
    <monitor>Primary</monitor>
    <primaryMonitor>1</primaryMonitor>
  </placement>

  <theme>
    <name>Clearlooks</name>
    <titleLayout>NLIMC</titleLayout>
    <keepBorder>yes</keepBorder>
    <animateIconify>yes</animateIconify>
    <!-- DejaVu Sans (fonts-dejavu-core) is clearer than the fontconfig
         'sans' default and is used across the titlebar, menus and OSDs at a
         larger size for readability over VNC. -->
    <font place="ActiveWindow">
      <name>DejaVu Sans</name>
      <size>10</size>
      <weight>bold</weight>
      <slant>normal</slant>
    </font>
    <font place="InactiveWindow">
      <name>DejaVu Sans</name>
      <size>10</size>
      <weight>normal</weight>
      <slant>normal</slant>
    </font>
    <font place="MenuHeader">
      <name>DejaVu Sans</name>
      <size>10</size>
      <weight>bold</weight>
      <slant>normal</slant>
    </font>
    <font place="MenuItem">
      <name>DejaVu Sans</name>
      <size>10</size>
      <weight>normal</weight>
      <slant>normal</slant>
    </font>
    <font place="ActiveOnScreenDisplay">
      <name>DejaVu Sans</name>
      <size>10</size>
      <weight>bold</weight>
      <slant>normal</slant>
    </font>
    <font place="InactiveOnScreenDisplay">
      <name>DejaVu Sans</name>
      <size>10</size>
      <weight>bold</weight>
      <slant>normal</slant>
    </font>
  </theme>

  <desktops>
    <number>1</number>
    <firstdesk>1</firstdesk>
    <names>
      <name>Desktop</name>
    </names>
  </desktops>

  <resize>
    <drawContents>yes</drawContents>
    <popupShow>Nonpixel</popupShow>
    <popupPosition>Center</popupPosition>
    <popupFixed>0</popupFixed>
  </resize>

  <margin>
    <top>0</top>
    <bottom>0</bottom>
    <left>0</left>
    <right>0</right>
  </margin>

  <dock>
    <position>TopLeft</position>
    <floatingX>0</floatingX>
    <floatingY>0</floatingY>
    <noStrut>no</noStrut>
    <stacking>Above</stacking>
    <direction>Vertical</direction>
    <autoHide>no</autoHide>
    <hideDelay>300</hideDelay>
    <showDelay>300</showDelay>
    <moveButton>Middle</moveButton>
  </dock>

  <keyboard>
    <keybind key="A-Tab">
      <action name="NextWindow">
        <bar>yes</bar>
        <raise>yes</raise>
      </action>
    </keybind>
    <keybind key="A-S-Tab">
      <action name="PrevWindow">
        <bar>yes</bar>
        <raise>yes</raise>
      </action>
    </keybind>
    <keybind key="A-F4">
      <action name="Close"/>
    </keybind>
    <keybind key="A-F11">
      <action name="ToggleFullscreen"/>
    </keybind>
    <keybind key="A-space">
      <action name="ShowMenu"><menu>root-menu</menu></action>
    </keybind>
    <keybind key="A-F1">
      <action name="ShowMenu"><menu>client-menu</menu></action>
    </keybind>
    <keybind key="C-A-Delete">
      <action name="Exit"/>
    </keybind>
    <keybind key="W-r">
      <action name="Execute"><command>x-terminal-emulator</command></action>
    </keybind>
  </keyboard>

  <mouse>
    <dragThreshold>8</dragThreshold>
    <doubleClickTime>200</doubleClickTime>
    <context name="Frame">
      <mousebind button="A-Left" action="Press"><action name="Focus"/><action name="Raise"/></mousebind>
      <mousebind button="A-Left" action="Drag"><action name="Move"/></mousebind>
      <mousebind button="A-Right" action="Press"><action name="Focus"/><action name="Raise"/></mousebind>
      <mousebind button="A-Right" action="Drag"><action name="Resize"/></mousebind>
      <mousebind button="A-Middle" action="Press"><action name="Lower"/></mousebind>
      <mousebind button="A-Middle" action="Click"><action name="Unshade"/></mousebind>
    </context>
    <context name="Titlebar">
      <mousebind button="Left" action="Drag"><action name="Move"/></mousebind>
      <mousebind button="Left" action="DoubleClick"><action name="ToggleMaximize"/></mousebind>
      <mousebind button="Middle" action="Press"><action name="Lower"/></mousebind>
      <mousebind button="Right" action="Menu"><action name="ShowMenu"><menu>client-menu</menu></action></mousebind>
    </context>
    <context name="Root">
      <mousebind button="Right" action="Press"><action name="ShowMenu"><menu>root-menu</menu></action></mousebind>
      <mousebind button="Middle" action="Press"><action name="ShowMenu"><menu>client-list-combined-menu</menu></action></mousebind>
    </context>
  </mouse>

  <menu>
    <file>menu.xml</file>
    <hideDelay>200</hideDelay>
    <hideDuration>200</hideDuration>
    <showDelay>300</showDelay>
    <generateDecorations>yes</generateDecorations>
  </menu>

  <applications>
    <!-- Every normal window (the Agent Starter terminal and the GUI IDE)
         opens fullscreen: each variant is a single-main-window desktop, so
         the app should fill the KasmVNC/noVNC browser view immediately.
         Dialogs, menus and the openbox on-screen displays keep their own
         size. Use A-F11 to toggle fullscreen and A-F4 to close. -->
    <application type="normal">
      <fullscreen>yes</fullscreen>
    </application>
  </applications>

</openbox_config>
